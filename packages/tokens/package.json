{
  "name": "@hogoshi/tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./css": {
      "style": "./dist/tokens.css",
      "default": "./dist/tokens.css"
    },
    "./themes": {
      "style": "./dist/themes.css",
      "default": "./dist/themes.css"
    },
    "./tailwind": {
      "style": "./dist/tailwind-theme.css",
      "default": "./dist/tailwind-theme.css"
    },
    "./dist/tokens.css": {
      "style": "./dist/tokens.css",
      "default": "./dist/tokens.css"
    },
    "./dist/themes.css": {
      "style": "./dist/themes.css",
      "default": "./dist/themes.css"
    },
    "./dist/tailwind-theme.css": {
      "style": "./dist/tailwind-theme.css",
      "default": "./dist/tailwind-theme.css"
    }
  },
  "files": ["dist", "tokens"],
  "scripts": {
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "style-dictionary": "^4.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
